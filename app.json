{
  "expo": {
    "name": "MoviesFlix",
    "slug": "moviesflix-native",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "moviesflix",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#300b07",
    "android": {
      "versionCode": 2,
      "permissions": [
        "android.permission.REQUEST_INSTALL_PACKAGES"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#300b07",
        "foregroundImage": "./assets/images/icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.ahmad123dev.moviesflixnative"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "UIStatusBarHidden": true
      }
    },
    "androidStatusBar": {
      "hidden": true
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#300b07",
          "image": "./assets/images/icon.png",
          "imageWidth": 180
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false,
          "enableBackgroundRecording": false
        }
      ],
      "expo-image",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "githubRepo": "MAhmad25/TheMoviesFlix-Streaming-Platform",
      "router": {},
      "eas": {
        "projectId": "21887552-2feb-4411-b68d-7c03878ccacc"
      }
    }
  }
}
